+// Expose the live Three.js scene only in the Playwright server mode.
+function connectSceneProbe({ gl, scene, camera }) {
+  gl.domElement.inspectLayoutObject = (id) => {
+    if (gl.info.render.frame === 0) return null;
+    const object = scene.getObjectByName(`layout:${id}`);
+    if (!object) return null;
+
+    object.updateWorldMatrix(true, true);
+    const model = object.getObjectByName('floor-lamp-model');
+    const surface = model?.getObjectByName('floor-lamp-shade') ?? object;
+    const position = object.getWorldPosition(new THREE.Vector3());
+    const axis = new THREE.Vector3(1, 0, 0).transformDirection(surface.matrixWorld);
+    const bounds = new THREE.Box3();
+    const toObjectSpace = object.matrixWorld.clone().invert();
+    (model ?? object).traverse((mesh) => {
+      if (!mesh.isMesh) return;
+      if (!mesh.geometry.boundingBox) mesh.geometry.computeBoundingBox();
+      const toLocal = new THREE.Matrix4().multiplyMatrices(toObjectSpace, mesh.matrixWorld);
+      bounds.union(mesh.geometry.boundingBox.clone().applyMatrix4(toLocal));
+    });
+    const size = bounds.getSize(new THREE.Vector3());
+    const center = surface.getWorldPosition(new THREE.Vector3()).project(camera);
+    const rect = gl.domElement.getBoundingClientRect();
+
+    return {
+      position: position.toArray(),
+      axis: axis.toArray(),
+      size: size.toArray(),
+      screen: { x: (center.x + 1) * rect.width / 2, y: (1 - center.y) * rect.height / 2 },
+    };
+  };
+}
+
